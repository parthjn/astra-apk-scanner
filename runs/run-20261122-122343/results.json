  "lessons": {
    "accepted": [
      "Exported Android components that extract nested Intent extras and forward them to startActivity or startService introduce Intent Redirection vulnerabilities; search for getParcelableExtra calls whose output is passed directly to launch component methods.",
      "Using naive string comparison methods like endsWith or contains for URL or hostname validation allows domain spoofing; search for string matching on domain parameters and verify that Uri.getHost() is used with exact host allowlists.",
      "Instantiating classes from external applications using createPackageContext with CONTEXT_INCLUDE_CODE and CONTEXT_IGNORE_SECURITY enables arbitrary code execution; search for createPackageContext calls that use dynamic class loading or permissive context flags.",
      "Logging sensitive user credentials, tokens, or personal identifiable information via system logging APIs exposes data to logcat; audit Log utility calls for references to sensitive variables.",
      "Enabling setAllowUniversalAccessFromFileURLs or setAllowFileAccessFromFileURLs in WebSettings allows JavaScript executing inside file URLs to read arbitrary local files and bypass cross-origin restrictions; search WebSettings configurations for enabled file access flags.",
      "Hardcoding cloud infrastructure configurations, AWS Identity Pool IDs, or API keys in application source code or XML resources allows unauthorized access via decompilation; search codebases and string resources for credential patterns."
    ],
    "rejected_as_instance_specific": [
      "Embedding static authentication credentials or secret keys in source code allows attackers to reverse-engineer and misuse them; search for inline assignment of authentication pairs or secret strings."
    ]
  },
