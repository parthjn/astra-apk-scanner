# Copy to .env and fill in whatever you have. Nothing is hard-coded; providers
# read their key from the env var named below. You only need the key(s) for the
# providers referenced in your config (default config uses Gemini for both roles).

# Teacher (frontier) — Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Student (open model) — Groq free tier, no card: https://console.groq.com/keys
GROQ_API_KEY=

# Optional additional providers (adding one is a config change, not a code change)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
